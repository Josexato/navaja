<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- El visor no necesita permisos. La cámara sólo se pide (en tiempo de
         ejecución) al entrar en el escáner 3D; todo se procesa en el dispositivo. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Afinador: el micrófono sólo se pide al abrirlo; el audio no sale del teléfono. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Escáner de red local: ver la red actual y conectar por TCP dentro de la LAN. No sale a internet. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Red móvil: Android exige ubicación para leer las celdas de radio; READ_PHONE_STATE para
         Dual SIM y el indicador 5G NSA. Se piden al abrir esa función; nada sale del teléfono. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <!-- Firma de PDF: huella/rostro (o PIN) antes de usar la clave del Keystore. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="Navaja"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Escáner 3D por fotos sobre escenario impreso (Android 11+). -->
        <activity
            android:name=".scan3d.ScanActivity"
            android:exported="false"
            android:label="Navaja · Escáner 3D"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Afinador de guitarra y violín (micrófono + detección de tono YIN). -->
        <activity
            android:name=".tuner.TunerActivity"
            android:exported="false"
            android:label="Navaja · Afinador"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Escáner de red local (sólo la propia subred Wi‑Fi). -->
        <activity
            android:name=".lan.LanActivity"
            android:exported="false"
            android:label="Navaja · Red local"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Pantonera: color y composición de una muestra sobre hoja blanca (usa la app de cámara). -->
        <activity
            android:name=".pantonera.PantoneraActivity"
            android:exported="false"
            android:label="Navaja · Pantonera"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Red móvil · modo ingeniería (celdas, señal, recorrido con GPS, torres estimadas). -->
        <activity
            android:name=".cellular.CellularActivity"
            android:exported="false"
            android:label="Navaja · Red móvil"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Marcador de ubicaciones: waypoints, fotos con GPS en el EXIF, KMZ/GPX. -->
        <activity
            android:name=".marker.MarkerActivity"
            android:exported="false"
            android:label="Navaja · Marcador"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Brújula y nivel. Vertical fija: el nivel "de canto" gira su propio dibujo. -->
        <activity
            android:name=".compass.CompassActivity"
            android:exported="false"
            android:label="Navaja · Brújula y nivel"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Pulso: magnificación euleriana en vivo y frecuencia cardíaca por cámara. -->
        <activity
            android:name=".pulse.PulseActivity"
            android:exported="false"
            android:label="Navaja · Pulso"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Medir un objeto desde un video: seguimiento de puntos + estructura desde movimiento. -->
        <activity
            android:name=".measure.MeasureActivity"
            android:exported="false"
            android:label="Navaja · Medir"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Firma de PDF verificable (SSJF): lápiz + QR + clave del Keystore + historial. También
             recibe "Abrir con" de un PDF y el texto de un QR compartido desde la cámara o Lens. -->
        <activity
            android:name=".sign.SignActivity"
            android:exported="true"
            android:label="Navaja · Firma"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize">
            <intent-filter android:label="Firmar o verificar con Navaja">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter android:label="Firmar o verificar con Navaja">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter android:label="Verificar firma SSJF">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
