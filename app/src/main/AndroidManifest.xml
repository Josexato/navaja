<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- El visor no necesita permisos. La cámara sólo se pide (en tiempo de
         ejecución) al entrar en el escáner 3D; todo se procesa en el dispositivo. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Afinador: el micrófono sólo se pide al abrirlo; el audio no sale del teléfono. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Escáner de red local: ver la red actual y conectar por TCP dentro de la LAN. No sale a internet. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Red móvil: Android exige ubicación para leer las celdas de radio; READ_PHONE_STATE para
         Dual SIM y el indicador 5G NSA. Se piden al abrir esa función; nada sale del teléfono. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:allowBackup="true"
        android:label="Navaja"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Escáner 3D por fotos sobre escenario impreso (Android 11+). -->
        <activity
            android:name=".scan3d.ScanActivity"
            android:exported="false"
            android:label="Navaja · Escáner 3D"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Afinador de guitarra y violín (micrófono + detección de tono YIN). -->
        <activity
            android:name=".tuner.TunerActivity"
            android:exported="false"
            android:label="Navaja · Afinador"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Escáner de red local (sólo la propia subred Wi‑Fi). -->
        <activity
            android:name=".lan.LanActivity"
            android:exported="false"
            android:label="Navaja · Red local"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Pantonera: color y composición de una muestra sobre hoja blanca (usa la app de cámara). -->
        <activity
            android:name=".pantonera.PantoneraActivity"
            android:exported="false"
            android:label="Navaja · Pantonera"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Red móvil · modo ingeniería (celdas, señal, recorrido con GPS, torres estimadas). -->
        <activity
            android:name=".cellular.CellularActivity"
            android:exported="false"
            android:label="Navaja · Red móvil"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
