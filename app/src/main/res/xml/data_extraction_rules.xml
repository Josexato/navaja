<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: mismas exclusiones que backup_rules.xml, para la nube y para la copia entre teléfonos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="firmas/" />
        <exclude domain="sharedpref" path="ssjf.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="firmas/" />
        <exclude domain="sharedpref" path="ssjf.xml" />
    </device-transfer>
</data-extraction-rules>
